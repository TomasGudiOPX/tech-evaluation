COMPOSE_PROJECT_NAME=shopping-cart
# Bind to loopback so a host-level TLS proxy can be the only public entry point.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-this-before-deploying

# Needed only when the frontend is served separately during development.
CORS_ORIGIN=http://localhost:5173

# Required by API authentication.
JWT_SECRET=replace-with-a-long-random-development-secret

# Optional development-only admin seed. Leave blank to skip admin creation.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-local-admin-password

# Optional: leave blank to keep the MCP endpoint disabled.
MCP_API_TOKEN=
